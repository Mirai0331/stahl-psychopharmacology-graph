# Google Cloud Document AI 配置模板
# 复制此文件为 .env 并填入您的真实信息

# 您的 Google Cloud 项目 ID
GCP_PROJECT_ID=your-gcp-project-id

# 您的 Document AI 处理器所在区域 (us, eu, 或 global)
GCP_LOCATION=us

# 您的 Document AI Processor ID (在 GCP 控制台 Document AI 页面创建并获取)
GCP_PROCESSOR_ID=your-processor-id

# 可选：指定服务账号密钥 JSON 路径（如果不使用系统默认凭证 ADC）
# GOOGLE_APPLICATION_CREDENTIALS="C:/path/to/service-account-key.json"

# 单次请求切片页数（Document AI online process 推荐 <= 15）
CHUNK_SIZE_PAGES=15

# 输出目录
OUTPUT_DIR="output"
CACHE_DIR="cache"
